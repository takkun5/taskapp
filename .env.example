# Air Mobility News Aggregator - Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key (optional - for AI summarization)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional - alternative AI provider)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI Provider to use: "openai" or "anthropic"
# This can also be set in config.yaml
AI_PROVIDER=openai

# Enable/disable AI features (true/false)
# If disabled, the app will only collect and list articles without AI processing
AI_ENABLED=true
